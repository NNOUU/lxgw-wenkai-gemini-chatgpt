{
  "manifest_version": 3,
  "name": "霞鹜文楷 for Gemini & ChatGPT",
  "version": "2.1.0",
  "description": "将 Google Gemini 与 OpenAI ChatGPT 网页端的文本字体修改为「霞鹜文楷 (LXGW WenKai)」，支持单字重屏幕阅读版加粗/斜体增强，完美保护图标与公式。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "霞鹜文楷字体设置 (Gemini & ChatGPT)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
